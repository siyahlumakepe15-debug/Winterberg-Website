#!/usr/bin/env python3
"""Rebuilds assets/js/search-index.js from the site pages. Run after editing page text:  python tools/build_search_index.py"""
import sys, os, json, re
from html.parser import HTMLParser
ROOT = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
PAGES = [("index.html", "Home"), ("pages/about.html", "About"), ("pages/programs.html", "Programs"),
         ("pages/products.html", "Products"), ("pages/enquiry.html", "Enquiry"), ("pages/contact.html", "Contact")]
SKIP = {"script", "style", "noscript", "option", "svg", "nav", "select", "textarea", "input", "label", "button_x"}

class P(HTMLParser):
    def __init__(self):
        super().__init__(); self.in_main = False; self.skip = 0; self.entries = []; self.cur = None
        self.anchor = ""; self.in_h = False; self.depth_skip = []; self.hbuf = ""
    def start(self, h):
        self.cur = {"h": h, "a": self.anchor, "t": []}; self.entries.append(self.cur)
    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if tag == "main": self.in_main = True
        if not self.in_main: return
        if tag in ("section", "div") and d.get("id"): self.anchor = d["id"]
        if tag in SKIP and tag not in ("button_x",): self.skip += 1
        if tag in ("h1", "h2", "h3"): self.in_h = True; self.hbuf = ""
    def handle_endtag(self, tag):
        if tag == "main": self.in_main = False
        if not self.in_main: return
        if tag in SKIP: self.skip = max(0, self.skip - 1)
        if tag in ("h1", "h2", "h3") and self.in_h:
            self.in_h = False; self.start(re.sub(r"\s+", " ", self.hbuf).strip())
    def handle_data(self, data):
        if not self.in_main or self.skip: return
        if self.in_h: self.hbuf += data; return
        if self.cur is None: self.start("")
        t = data.strip()
        if t: self.cur["t"].append(t)

index = []
for rel, title in PAGES:
    p = P(); p.feed(open(os.path.join(ROOT, rel), encoding="utf-8").read())
    for e in p.entries:
        text = re.sub(r"\s+", " ", " ".join(e["t"])).strip()
        if not (e["h"] or text): continue
        if not e["h"]: e["h"] = title
        index.append({"p": title, "u": rel + ("#" + e["a"] if e["a"] else ""), "h": e["h"], "x": text})
js = "/* Generated by mkindex.py from the page content. Do not edit by hand. */\nwindow.WB_INDEX = " + json.dumps(index, ensure_ascii=False) + ";\n"
open(os.path.join(ROOT, "assets/js/search-index.js"), "w", encoding="utf-8").write(js)
print(len(index), "entries")
